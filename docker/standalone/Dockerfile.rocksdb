# Runtime image for NebulaGraph standalone (official RocksDB build).
# Build context must contain a prepared install tree at ./install/
# (bin/, etc/nebula-standalone.conf, lib/ if any) after strip.
FROM ubuntu:24.04

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash ca-certificates curl \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system nebula \
  && useradd --system --gid nebula --home-dir /usr/local/nebula --no-create-home nebula

COPY install/ /usr/local/nebula/
COPY entrypoint-rocksdb.sh /usr/local/nebula/bin/entrypoint.sh

RUN chmod +x /usr/local/nebula/bin/entrypoint.sh /usr/local/nebula/bin/nebula-standalone \
  && mkdir -p /usr/local/nebula/{logs,data,pids} \
  && test -f /usr/local/nebula/etc/nebula-standalone.conf \
  && chown -R nebula:nebula /usr/local/nebula

WORKDIR /usr/local/nebula
USER nebula

EXPOSE 9669 9559 9779 19669 19559 19779

ENTRYPOINT ["/usr/local/nebula/bin/entrypoint.sh"]
